# Docker Compose Environment Configuration
# This file contains Docker-specific environment variables
# Copy this to .env when using Docker Compose

# =============================================================================
# Docker Configuration
# =============================================================================

# Docker image name and tag
DOCKER_IMAGE_NAME=mahder-frontend
DOCKER_IMAGE_TAG=latest

# Container configuration
CONTAINER_NAME=mahder-frontend-app
HOST_PORT=3001

# =============================================================================
# Application Environment Variables
# =============================================================================

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Authentication Configuration
NEXTAUTH_SECRET=your-strong-secret-here-minimum-32-characters
NEXTAUTH_URL=http://localhost:3001

# Node Environment
NODE_ENV=production

# =============================================================================
# Production Docker Example
# =============================================================================
# For production deployment:
#
# DOCKER_IMAGE_NAME=your-registry/mahder-frontend
# DOCKER_IMAGE_TAG=v1.0.0
# CONTAINER_NAME=mahder-frontend-prod
# HOST_PORT=80
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api
# NEXT_PUBLIC_BASE_URL=https://yourdomain.com
# NEXTAUTH_SECRET=your-very-strong-production-secret
# NEXTAUTH_URL=https://yourdomain.com
# NODE_ENV=production
